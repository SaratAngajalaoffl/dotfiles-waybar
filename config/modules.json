{
    "hyprland/workspaces": {
        "on-click": "activate",
        "active-only": false,
        "all-outputs": true,
        "format": "{icon}",
        "format-icons": {
            "urgent": "",
            "active": "",
            "default": ""
        },
        "persistent_workspaces": {
            "*": 5
        }
    },
    "tray": {
        "spacing": 10
    },
    "clock": {
        "interval": 1,
        "format": "{:%a, %d %b, %I:%M:%S %p}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "on-click": "~/.config/waybar/scripts/toggle_calendar.sh"
    },
    "wireplumber": {
        "format": " {volume}%",
        "tooltip": true,
        "on-click": "eww open --toggle audio-control"
    },
    "custom/playback": {
        "exec-if": "~/.config/waybar/scripts/should_show_playback.sh",
        "exec": "~/.config/waybar/scripts/current_playback.sh",
        "return-type": "json",
        "interval": 1,
        "format": "{icon} {text}",
        "tooltip": false,
        "on-click": "playerctl play-pause",
        "format-icons": {
            "playing": "",
            "paused": "",    
            "stopped": ""
        }
    },
    "custom/bluetooth": {
        "exec": "~/.config/waybar/scripts/bluetooth_data.sh",
        "return-type": "json",
        "interval": 1,
        "format": " {text}",
        "tooltip": true,
        "on-click": "eww open --toggle bluetooth-control"
    },
    "custom/user": {
        "format": "",
        "tooltip-format": "mugiwara",
        "tooltip": true,
        "on-click": "eww open --toggle user-menu"
    },
    "custom/clipboard": {
        "format": "",
        "tooltip-format": "Clipboard history",
        "tooltip": true,
        "on-click": "eww open --toggle clipboard-history"
    }
}
